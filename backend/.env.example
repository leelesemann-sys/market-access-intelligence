# HTA Intelligence - Environment Variables Template
# Copy to .env and fill in your values

# Azure SQL
HTA_SQL_SERVER=hta-intelligence-sql.database.windows.net
HTA_SQL_DATABASE=hta_intelligence_db
HTA_SQL_USER=htaadmin
HTA_SQL_PASSWORD=<your-password>

# Azure AI Search
HTA_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
HTA_SEARCH_KEY=<admin-key>

# Azure OpenAI
HTA_OPENAI_ENDPOINT=https://germanywestcentral.api.cognitive.microsoft.com/
HTA_OPENAI_KEY=<api-key>

# NICE API (optional, for future use)
# NICE_API_KEY=<api-key>
